# ==============================================================================
# ARCHIVED WORKFLOW - DISABLED
# ==============================================================================
# This workflow was previously used for static deployment to GitHub Pages.
# It has been archived and disabled by renaming to .github/workflows/gh-pages.yml.disabled
# to prevent concurrent dual-deployment conflicts with Cloudflare Pages CI/CD.
#
# Active CI/CD deployment pipeline: .github/workflows/deploy-cloudflare.yml
# ==============================================================================

name: Deploy to GitHub Pages

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./dist

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
