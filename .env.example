# ============================================================================
# ExplodeIt: Environment Configuration Template (.env.example)
# Copy this file to .env (for Vite / local builds) or .dev.vars (for Wrangler Pages Functions)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Cloudflare Account & Authentication (CI/CD & Remote Deployments)
# ----------------------------------------------------------------------------
# Your 32-character Cloudflare Account ID.
# Found on the Cloudflare Dashboard home page (right sidebar) or via `npx wrangler whoami`.
# Required for: GitHub Actions deployment workflow (secret: CLOUDFLARE_ACCOUNT_ID)
# and manual `wrangler pages deploy` commands.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Scoped Cloudflare API Token with the following permissions:
# - Account: Cloudflare Pages: Edit
# - Account: Workers R2 Storage: Edit
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required for: GitHub Actions deployment workflow (secret: CLOUDFLARE_API_TOKEN)
# and remote Wrangler operations.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ----------------------------------------------------------------------------
# 2. Project & Storage Identifiers
# ----------------------------------------------------------------------------
# Name of the Cloudflare Pages project.
# Must match the "name" property in wrangler.jsonc.
# Default: explodeit
CLOUDFLARE_PROJECT_NAME=explodeit

# Name of the Cloudflare R2 bucket used for community generation storage.
# Must match the "bucket_name" in wrangler.jsonc under r2_buckets.
# Default: explodeit-community
CLOUDFLARE_R2_BUCKET_NAME=explodeit-community

# ----------------------------------------------------------------------------
# 3. Cloudflare Pages Functions Runtime Variables (.dev.vars & Cloudflare Dashboard)
# ----------------------------------------------------------------------------
# Optional: Public CDN URL or custom domain mapped to the R2 bucket.
# Examples:
#   - https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
#   - https://community.explodeit.org
# If left blank or omitted, ExplodeIt automatically serves and streams media
# directly through the built-in Pages Function streaming proxy:
#   /api/contribute?assetPath=topics/<topicId>/<asset>
# For local edge development, set this in .dev.vars if testing custom CDN URLs.
COMMUNITY_PUBLIC_URL=

# ----------------------------------------------------------------------------
# 4. Client-Side & Build-Time Configuration (Vite)
# ----------------------------------------------------------------------------
# Optional fallback Google GenAI (Gemini) API Key for hosted demo / kiosk environments.
# ExplodeIt adheres strictly to a Bring-Your-Own-Key (BYOK) architecture:
# - End-users enter their own API key via the in-app modal (stored in sessionStorage).
# - If GEMINI_API_KEY is left empty, the application will prompt the user on first generation.
# - If provided at build time, it will be injected as the default key for visitors.
GEMINI_API_KEY=

# Base URL path for static asset hosting in Vite.
# Default: ./ (relative paths for maximum portability across root and subpath hosting)
# Set to / or /custom-subpath/ if serving from a specific root or domain subpath.
VITE_BASE_PATH=./
